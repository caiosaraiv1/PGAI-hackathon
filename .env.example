# Copie este arquivo para .env e preencha com sua chave.
# Chave da Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo Gemini (opcional). Se ficar vazio, usa o padrão definido em services/llm.py.
LLM_MODEL=
# Use 1 para trocar a API pelas respostas de services/fixtures/ (não gasta cota nem exige chave).
LLM_MOCK=
